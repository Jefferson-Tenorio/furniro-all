# Porta que a API irá ouvir
PORT=3000

# URL do frontend para CORS
FRONTEND_URL=http://localhost:5173

# Segredo usado para assinar os tokens JWT (troque em produção)
JWT_SECRET=furniro-development-secret

# Tempo de expiração do token em milissegundos (1 hora)
JWT_EXPIRES_IN_MS=3600000

# Emissor e audiência dos tokens JWT
JWT_ISSUER=furniro-api
JWT_AUDIENCE=furniro-client
