{
  "name": "furniro-all",
  "private": true,
  "version": "1.0.0",
  "description": "Monorepo do desafio Furniro: API Express + Prisma (backend) e React + Vite (frontend)",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "check": "node scripts/check.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "node scripts/clean.mjs",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "db:reset": "npm run db:reset --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "ISC"
}
